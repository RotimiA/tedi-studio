NEXT_PUBLIC_SANITY_PROJECT_ID=2b36x4rg
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. A Sanity token with write access to the dataset.
SANITY_API_WRITE_TOKEN=

# Server-only Notion integration token. Share only the Projects database with it.
NOTION_TOKEN=
NOTION_PROJECTS_DATA_SOURCE_ID=269cf752-d448-811b-b721-000b89872313
NOTION_PROJECTS_DATABASE_ID=269cf752-d448-81c4-bb3f-cabfa99714b3

# Protects POST /api/sync/projects. Send it as `Authorization: Bearer <secret>`.
SYNC_SECRET=

# Notion webhook signing secret. The first verification request stores the token in
# .notion-webhook-token when this is empty. Move that value here, then delete the file.
NOTION_WEBHOOK_SECRET=
